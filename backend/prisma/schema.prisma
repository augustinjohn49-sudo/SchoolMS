// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model School {
  id        String       @id @default(uuid())
  name      String
  code      String       @unique
  type      SchoolType
  location  String?
  email     String?
  phone     String?
  address   String?
  logo      String?
  status    SchoolStatus @default(ACTIVE)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  users           User[]
  students        Student[]
  staff           Staff[]
  academicYears   AcademicYear[]
  subjects        Subject[]
  exams           Exam[]
  gradingScales   GradingScale[]
  parentGuardians ParentGuardian[]
  announcements   Announcement[]
  notifications   Notification[]
  conversations   Conversation[]
}

model User {
  id           String     @id @default(uuid())
  schoolId     String?
  firstName    String
  lastName     String
  email        String     @unique
  passwordHash String
  role         UserRole   @default(SCHOOL_ADMIN)
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  school                   School?                   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  staff                    Staff?
  parentGuardian           ParentGuardian?
  createdAnnouncements     Announcement[]
  announcementRecipients   AnnouncementRecipient[]
  notificationRecipients   NotificationRecipient[]
  conversationParticipants ConversationParticipant[]
  sentMessages             Message[]

  @@index([schoolId])
  @@index([role])
}

model Staff {
  id             String         @id @default(uuid())
  schoolId       String
  userId         String?        @unique
  staffNumber    String
  firstName      String
  middleName     String?
  lastName       String
  gender         StaffGender
  dateOfBirth    DateTime?
  phone          String?
  email          String?
  address        String?
  position       StaffPosition
  employmentType EmploymentType @default(FULL_TIME)
  status         StaffStatus    @default(ACTIVE)
  dateJoined     DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  school             School                @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user               User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)
  teacherAssignments TeacherClassSubject[]

  @@unique([schoolId, staffNumber])
  @@index([schoolId])
  @@index([status])
  @@index([position])
}

model AcademicYear {
  id        String             @id @default(uuid())
  schoolId  String
  name      String
  startDate DateTime
  endDate   DateTime
  status    AcademicYearStatus @default(INACTIVE)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  school             School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  terms              Term[]
  classes            Class[]
  studentEnrollments StudentEnrollment[]
  attendanceRecords  Attendance[]
  exams              Exam[]
  reportCards        ReportCard[]

  @@unique([schoolId, name])
  @@index([schoolId])
  @@index([status])
}

model Student {
  id              String        @id @default(uuid())
  schoolId        String
  admissionNumber String
  firstName       String
  middleName      String?
  lastName        String
  dateOfBirth     DateTime?
  gender          StudentGender
  phone           String?
  email           String?
  address         String?
  status          StudentStatus @default(ACTIVE)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  school            School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  enrollments       StudentEnrollment[]
  attendanceRecords Attendance[]
  examResults       ExamResult[]
  guardians         StudentGuardian[]

  @@unique([schoolId, admissionNumber])
  @@index([schoolId])
  @@index([status])
}

model ParentGuardian {
  id             String               @id @default(uuid())
  schoolId       String
  userId         String?              @unique
  firstName      String
  middleName     String?
  lastName       String
  phone          String
  alternatePhone String?
  email          String?
  address        String?
  occupation     String?
  status         ParentGuardianStatus @default(ACTIVE)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  school   School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user     User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  students StudentGuardian[]

  @@index([schoolId])
  @@index([status])
  @@index([phone])
}

model StudentGuardian {
  id                 String               @id @default(uuid())
  studentId          String
  parentGuardianId   String
  relationship       GuardianRelationship
  isPrimary          Boolean              @default(false)
  isEmergencyContact Boolean              @default(false)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  student        Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  parentGuardian ParentGuardian @relation(fields: [parentGuardianId], references: [id], onDelete: Cascade)

  @@unique([studentId, parentGuardianId])
  @@index([studentId])
  @@index([parentGuardianId])
  @@index([relationship])
}

model StudentEnrollment {
  id             String           @id @default(uuid())
  studentId      String
  academicYearId String
  classId        String
  streamId       String?
  enrolledAt     DateTime         @default(now())
  status         EnrollmentStatus @default(ACTIVE)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  student      Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  class        Class        @relation(fields: [classId], references: [id], onDelete: Cascade)
  stream       Stream?      @relation(fields: [streamId], references: [id], onDelete: SetNull)
  reportCards  ReportCard[]

  @@unique([studentId, academicYearId])
  @@index([studentId])
  @@index([academicYearId])
  @@index([classId])
  @@index([streamId])
  @@index([status])
}

model Term {
  id             String     @id @default(uuid())
  academicYearId String
  name           String
  startDate      DateTime
  endDate        DateTime
  status         TermStatus @default(INACTIVE)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  academicYear      AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  attendanceRecords Attendance[]
  exams             Exam[]
  reportCards       ReportCard[]

  @@unique([academicYearId, name])
  @@index([academicYearId])
  @@index([status])
}

model Exam {
  id             String     @id @default(uuid())
  schoolId       String
  academicYearId String
  termId         String
  name           String
  description    String?
  startDate      DateTime
  endDate        DateTime
  status         ExamStatus @default(DRAFT)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  school       School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYear AcademicYear  @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  term         Term          @relation(fields: [termId], references: [id], onDelete: Cascade)
  subjects     ExamSubject[]

  @@unique([schoolId, academicYearId, name])
  @@index([schoolId])
  @@index([academicYearId])
  @@index([termId])
  @@index([status])
}

model ExamSubject {
  id             String   @id @default(uuid())
  examId         String
  classSubjectId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  exam         Exam         @relation(fields: [examId], references: [id], onDelete: Cascade)
  classSubject ClassSubject @relation(fields: [classSubjectId], references: [id], onDelete: Cascade)
  results      ExamResult[]

  @@unique([examId, classSubjectId])
  @@index([examId])
  @@index([classSubjectId])
}

model ExamResult {
  id            String   @id @default(uuid())
  studentId     String
  examSubjectId String
  marks         Decimal
  maxMarks      Decimal
  remarks       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  student            Student             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  examSubject        ExamSubject         @relation(fields: [examSubjectId], references: [id], onDelete: Cascade)
  reportCardSubjects ReportCardSubject[]

  @@unique([studentId, examSubjectId])
  @@index([studentId])
  @@index([examSubjectId])
}

model GradingScale {
  id          String   @id @default(uuid())
  schoolId    String
  name        String
  description String?
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  school      School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  grades      Grade[]
  reportCards ReportCard[]

  @@unique([schoolId, name])
  @@index([schoolId])
  @@index([isDefault])
}

model Grade {
  id             String   @id @default(uuid())
  gradingScaleId String
  name           String
  minPercentage  Decimal
  maxPercentage  Decimal
  remarks        String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  gradingScale GradingScale @relation(fields: [gradingScaleId], references: [id], onDelete: Cascade)

  @@unique([gradingScaleId, name])
  @@index([gradingScaleId])
}

model Class {
  id             String   @id @default(uuid())
  academicYearId String
  name           String
  level          Int?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  academicYear       AcademicYear        @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  streams            Stream[]
  studentEnrollments StudentEnrollment[]
  classSubjects      ClassSubject[]
  timetableEntries   TimetableEntry[]
  attendanceRecords  Attendance[]

  @@unique([academicYearId, name])
  @@index([academicYearId])
}

model Stream {
  id        String   @id @default(uuid())
  classId   String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  class Class @relation(fields: [classId], references: [id], onDelete: Cascade)

  studentEnrollments StudentEnrollment[]

  @@unique([classId, name])
  @@index([classId])
}

model Subject {
  id          String        @id @default(uuid())
  schoolId    String
  name        String
  code        String
  description String?
  status      SubjectStatus @default(ACTIVE)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  school        School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classSubjects ClassSubject[]

  @@unique([schoolId, name])
  @@unique([schoolId, code])
  @@index([schoolId])
  @@index([status])
}

model ClassSubject {
  id        String   @id @default(uuid())
  classId   String
  subjectId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  class              Class                 @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject            Subject               @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacherAssignments TeacherClassSubject[]
  examSubjects       ExamSubject[]

  @@unique([classId, subjectId])
  @@index([classId])
  @@index([subjectId])
}

model TeacherClassSubject {
  id             String   @id @default(uuid())
  staffId        String
  classSubjectId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  staff            Staff            @relation(fields: [staffId], references: [id], onDelete: Cascade)
  classSubject     ClassSubject     @relation(fields: [classSubjectId], references: [id], onDelete: Cascade)
  timetableEntries TimetableEntry[]

  @@unique([staffId, classSubjectId])
  @@index([staffId])
  @@index([classSubjectId])
}

model TimetableEntry {
  id                    String   @id @default(uuid())
  classId               String
  teacherClassSubjectId String
  dayOfWeek             Int
  startTime             String
  endTime               String
  room                  String?
  notes                 String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  class               Class               @relation(fields: [classId], references: [id], onDelete: Cascade)
  teacherClassSubject TeacherClassSubject @relation(fields: [teacherClassSubjectId], references: [id], onDelete: Cascade)

  @@index([classId])
  @@index([teacherClassSubjectId])
  @@index([dayOfWeek])
}

model Attendance {
  id             String           @id @default(uuid())
  studentId      String
  academicYearId String
  termId         String?
  classId        String
  date           DateTime
  status         AttendanceStatus
  remarks        String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  student      Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  term         Term?        @relation(fields: [termId], references: [id], onDelete: SetNull)
  class        Class        @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@unique([studentId, date])
  @@index([studentId])
  @@index([academicYearId])
  @@index([termId])
  @@index([classId])
  @@index([date])
  @@index([status])
}

model ReportCard {
  id                  String    @id @default(uuid())
  studentEnrollmentId String
  academicYearId      String
  termId              String
  gradingScaleId      String
  title               String?
  overallRemarks      String?
  classTeacherComment String?
  headTeacherComment  String?
  generatedAt         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  studentEnrollment StudentEnrollment   @relation(fields: [studentEnrollmentId], references: [id], onDelete: Cascade)
  academicYear      AcademicYear        @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  term              Term                @relation(fields: [termId], references: [id], onDelete: Cascade)
  gradingScale      GradingScale        @relation(fields: [gradingScaleId], references: [id], onDelete: Restrict)
  status            ReportCardStatus    @default(DRAFT)
  subjects          ReportCardSubject[]

  @@unique([studentEnrollmentId, termId])
  @@index([studentEnrollmentId])
  @@index([academicYearId])
  @@index([termId])
  @@index([gradingScaleId])
}

model ReportCardSubject {
  id           String   @id @default(uuid())
  reportCardId String
  examResultId String
  subjectName  String
  marks        Decimal
  maxMarks     Decimal
  percentage   Decimal
  gradeName    String?
  gradeRemarks String?
  remarks      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  reportCard ReportCard @relation(fields: [reportCardId], references: [id], onDelete: Cascade)
  examResult ExamResult @relation(fields: [examResultId], references: [id], onDelete: Restrict)

  @@unique([reportCardId, examResultId])
  @@index([reportCardId])
  @@index([examResultId])
}

model Announcement {
  id              String               @id @default(uuid())
  schoolId        String
  createdByUserId String
  title           String
  content         String
  audience        AnnouncementAudience
  status          AnnouncementStatus   @default(DRAFT)
  publishedAt     DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  school     School                  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  creator    User                    @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)
  recipients AnnouncementRecipient[]

  @@index([schoolId])
  @@index([createdByUserId])
  @@index([status])
  @@index([audience])
}

model AnnouncementRecipient {
  id             String    @id @default(uuid())
  announcementId String
  userId         String
  isRead         Boolean   @default(false)
  readAt         DateTime?
  createdAt      DateTime  @default(now())

  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([announcementId, userId])
  @@index([announcementId])
  @@index([userId])
  @@index([isRead])
}

model Notification {
  id        String           @id @default(uuid())
  schoolId  String
  title     String
  message   String
  type      NotificationType
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  school     School                  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  recipients NotificationRecipient[]

  @@index([schoolId])
  @@index([type])
  @@index([createdAt])
}

model NotificationRecipient {
  id             String    @id @default(uuid())
  notificationId String
  userId         String
  isRead         Boolean   @default(false)
  readAt         DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([notificationId, userId])
  @@index([notificationId])
  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
}

model Conversation {
  id        String   @id @default(uuid())
  schoolId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school       School                    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  participants ConversationParticipant[]
  messages     Message[]

  @@index([schoolId])
  @@index([updatedAt])
}

model ConversationParticipant {
  id             String    @id @default(uuid())
  conversationId String
  userId         String
  joinedAt       DateTime  @default(now())
  lastReadAt     DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([conversationId])
  @@index([userId])
}

model Message {
  id             String   @id @default(uuid())
  conversationId String
  senderUserId   String
  content        String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderUserId], references: [id], onDelete: Restrict)

  @@index([conversationId])
  @@index([senderUserId])
  @@index([createdAt])
}

enum NotificationType {
  ANNOUNCEMENT
  ATTENDANCE
  EXAM
  RESULT
  FEE
  GENERAL
}

enum AnnouncementAudience {
  ALL
  TEACHERS
  PARENTS
  STUDENTS
}

enum AnnouncementStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ParentGuardianStatus {
  ACTIVE
  INACTIVE
}

enum GuardianRelationship {
  FATHER
  MOTHER
  GUARDIAN
  GRANDPARENT
  SIBLING
  UNCLE
  AUNT
  OTHER
}

enum ReportCardStatus {
  DRAFT
  APPROVED
  PUBLISHED
}

enum ExamStatus {
  DRAFT
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum SchoolType {
  PRIMARY
  SECONDARY
  PRIMARY_AND_SECONDARY
}

enum SchoolStatus {
  ACTIVE
  INACTIVE
}

enum UserRole {
  SUPER_ADMIN
  SCHOOL_ADMIN
  TEACHER
  STUDENT
  PARENT
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum AcademicYearStatus {
  ACTIVE
  INACTIVE
  COMPLETED
}

enum TermStatus {
  ACTIVE
  INACTIVE
  COMPLETED
}

enum StudentGender {
  MALE
  FEMALE
  OTHER
}

enum StudentStatus {
  ACTIVE
  INACTIVE
  GRADUATED
  TRANSFERRED
  SUSPENDED
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  TRANSFERRED
  WITHDRAWN
}

enum StaffGender {
  MALE
  FEMALE
  OTHER
}

enum StaffPosition {
  TEACHER
  HEAD_TEACHER
  DEPUTY_HEAD_TEACHER
  SENIOR_TEACHER
  BURSAR
  SECRETARY
  COUNSELOR
  LIBRARIAN
  ICT_OFFICER
  NURSE
  SECURITY
  SUPPORT_STAFF
  OTHER
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  VOLUNTEER
}

enum StaffStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  TERMINATED
  RESIGNED
}

enum SubjectStatus {
  ACTIVE
  INACTIVE
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
}
